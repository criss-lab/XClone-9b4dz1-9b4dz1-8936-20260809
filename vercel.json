{
  "installCommand": "sed -i '/^node-options/d' .npmrc && npm install && node _patch-vite.cjs",
  "buildCommand": "node _build.cjs",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/.well-known/webfinger", "destination": "/api/federation?route=webfinger" },
    { "source": "/.well-known/nodeinfo", "destination": "/api/federation?route=nodeinfo" },
    { "source": "/nodeinfo/2.0", "destination": "/api/federation?route=nodeinfo20" },
    { "source": "/users/:username/inbox", "destination": "/api/federation?route=inbox&username=:username" },
    { "source": "/users/:username/outbox", "destination": "/api/federation?route=outbox&username=:username" },
    { "source": "/users/:username/followers", "destination": "/api/federation?route=followers&username=:username" },
    { "source": "/users/:username/following", "destination": "/api/federation?route=following&username=:username" },
    { "source": "/users/:username", "destination": "/api/federation?route=actor&username=:username" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
