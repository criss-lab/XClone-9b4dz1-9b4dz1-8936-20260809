{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "zeroConfig": false
      }
    }
  ],
  "installCommand": "sed -i '/^node-options/d' .npmrc && npm install && node _patch-vite.cjs",
  "buildCommand": "node _build.cjs",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/.well-known/webfinger", "destination": "https://zcjtvykwwplnzyyslnop.supabase.co/functions/v1/federation-public/.well-known/webfinger" },
    { "source": "/.well-known/nodeinfo", "destination": "https://zcjtvykwwplnzyyslnop.supabase.co/functions/v1/federation-public/.well-known/nodeinfo" },
    { "source": "/nodeinfo/2.1", "destination": "https://zcjtvykwwplnzyyslnop.supabase.co/functions/v1/federation-public/nodeinfo/2.1" },
    { "source": "/users/:username/inbox", "destination": "https://zcjtvykwwplnzyyslnop.supabase.co/functions/v1/federation-public/users/:username/inbox" },
    { "source": "/users/:username", "destination": "https://zcjtvykwwplnzyyslnop.supabase.co/functions/v1/federation-public/users/:username" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)\\.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)\\.css", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/sitemap.xml", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }, { "key": "Content-Type", "value": "application/xml" }] },
    { "source": "/sitemap-static.xml", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }, { "key": "Content-Type", "value": "application/xml" }] },
    { "source": "/sitemap-community.xml", "headers": [{ "key": "Cache-Control", "value": "public, max-age=21600" }, { "key": "Content-Type", "value": "application/xml" }] },
    { "source": "/robots.txt", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }, { "key": "Content-Type", "value": "text/plain" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Frame-Options", "value": "SAMEORIGIN" }, { "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }, { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self)" }, { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
