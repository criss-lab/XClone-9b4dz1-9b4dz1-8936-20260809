# Copy to .env on the public media host. Never commit the real .env.
MEDIA_ENGINE_SECRET=GENERATE_WITH_openssl_rand_hex_32
MEDIA_ENGINE_PUBLIC_IP=PUBLIC_IPV4
MEDIA_ENGINE_NODE_ID=native-1
MEDIA_ENGINE_ALLOWED_ORIGINS=https://YOUR_TESTAGRAM_ORIGIN
MEDIA_ENGINE_ICE_SERVERS=[{"urls":"stun:TURN_HOST:3478"},{"urls":"turn:TURN_HOST:3478?transport=udp","username":"TURN_USER","credential":"TURN_PASSWORD"},{"urls":"turns:TURN_HOST:5349?transport=tcp","username":"TURN_USER","credential":"TURN_PASSWORD"}]
TURN_REALM=TURN_HOST
TURN_USERNAME=TURN_USER
TURN_PASSWORD=GENERATE_WITH_openssl_rand_hex_24
MEDIA_ENGINE_UDP_MIN=10000
MEDIA_ENGINE_UDP_MAX=20000
TURN_MIN_PORT=49152
TURN_MAX_PORT=65535
MEDIA_ENGINE_MAX_VIEWERS=500
MEDIA_ENGINE_MAX_GUESTS=4
MEDIA_ENGINE_MAX_SPACE_PARTICIPANTS=1000
MEDIA_ENGINE_MAX_CALL_PARTICIPANTS=25
MEDIA_ENGINE_CONNECTIONS_PER_MINUTE=60
