{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "testagram-api",
  "main": "./worker/production-entrypoint.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "routes": [
    { "pattern": "api.testagram.site", "custom_domain": true }
  ],
  "vars": {
    "APP_ORIGIN": "https://testagram.site",
    "SUPABASE_URL": "https://aepbqfrmheihfsauzcby.supabase.co",
    "SUPABASE_PROJECT_REF": "aepbqfrmheihfsauzcby",
    "SUPABASE_JWKS_URL": "https://aepbqfrmheihfsauzcby.supabase.co/auth/v1/.well-known/jwks.json",
    "PAYPAL_ENV": "sandbox"
  },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "testagram-media" }]
}
// Federation is deployed independently as testagram-federation so it cannot overwrite the canonical API Worker route map.